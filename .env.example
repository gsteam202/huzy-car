# CAR HUZY Environment Variables Example

# Server & URL
PORT=5470
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://car.huzy.net
SITE_URL=https://car.huzy.net

# Database (MariaDB 11.x)
DATABASE_URL="mysql://huzy_car:YOUR_SECURE_PASSWORD@127.0.0.1:3306/huzy_car"

# Authentication (NextAuth / Auth.js)
NEXTAUTH_URL=https://car.huzy.net
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_HEX_OR_BASE64

# Google OAuth 2.0
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Car External Data APIs
XAPI_KEY=YOUR_XAPI_KEY
ENCAR_API_KEY=YOUR_ENCAR_API_KEY
MOLIT_API_KEY=MOCK_STAGE

# Tracking & SEO
NEXT_PUBLIC_GTM_ID=GTM-M2JCBBBF
NEXT_PUBLIC_NAVER_VERIFICATION=356ee301e0e87d7b038ae3033a166e9a994dbd51
