{
  "name": "huzy-car",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5470",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1 -p 5470",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test tests/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node --loader tsx/esm scripts/seed.ts",
    "test:withdrawal": "node --test tests/account-withdrawal.test.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@node-rs/argon2": "^2.0.2",
