    "@prisma/client": "7.10.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^1.16.0",
    "mariadb": "3.5.4",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "esbuild": "0.25.12"
  }
}
